DATABASE_URL=postgresql://sdrp:sdrp_local_dev@localhost:5432/sdrp
DATABASE_URL_TEST=postgresql://sdrp:sdrp_local_dev@localhost:5432/sdrp_test
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000

# Other origins this deployment answers on, comma-separated. Scheme and host
# only, no path. The origin of BETTER_AUTH_URL is trusted automatically.
#
# A sign-in POST from an origin that is not listed is refused with
# INVALID_ORIGIN (403), which the login form reports as "Incorrect email or
# password" — so a missing hostname here looks like everyone's password broke.
# Runtime, so adding one is a restart rather than an image rebuild.
TRUSTED_ORIGINS=

# Path this app is served under. Empty for a root deployment; '/reconciliation'
# behind the shared-nginx ingress on the Bajaj AI Platform VM.
#
# BUILD-TIME. Next bakes it into every route and asset URL, so changing it means
# rebuilding the image, not restarting the container.
NEXT_PUBLIC_BASE_PATH=

# Whether the session cookie carries `Secure`. Leave unset (defaults to true)
# anywhere reachable over HTTPS.
#
# Set to false ONLY on the shared VM, whose nginx ingress is plain :80 — a
# Secure cookie there is accepted and then never sent back, which presents as an
# infinite login loop. This is a real weakening: session cookies cross the LAN in
# clear text. See docs/deploy-vm.md.
COOKIE_SECURE=true

# Where reconciliation-ingest answers. `http://reconciliation-ingest:8000` on the
# shared network, where the service binds no host port at all.
#
# Both variables default, so a build works without them — but an upload whose
# parse job cannot be started is REFUSED (2026-07-28 ingestion spec section 7),
# so a deployment that leaves them wrong accepts no workbooks at all.
INGEST_URL=http://127.0.0.1:8000

# The shared secret sent as X-Ingest-Token. Must match the service's own
# INGEST_TOKEN, which requires at least 32 characters.
#
# Never prefixed NEXT_PUBLIC_: Next inlines those into the client bundle, and
# this is the only thing standing between the shared network and a service that
# reads the storage volume.
INGEST_TOKEN=local-dev-ingest-token-change-me
